---
import '../styles/global.css';

import { Font } from 'astro:assets';
import Sidebar from '../components/Sidebar.astro';
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';
import Panel from '../components/Panel.astro';
import SEO from '../components/SEO.astro';
import JsonLd from '../components/JsonLd.astro';
import BackToTop from '../components/islands/BackToTop.astro';
import { ClientRouter } from 'astro:transitions';
import faviconImg from '../assets/images/site/favicon.svg';
import faviconIco from '../assets/images/site/favicon.ico';
import { SITE, type Locale } from '../config';
import {
  detectLocale,
  htmlLang,
  htmlDir,
  useTranslations,
  stripLocale,
  withBase,
} from '../i18n/utils';
import { buildSeo, type SeoMeta } from '../utils/seo';
import { breadcrumbJsonLd, personJsonLd, websiteJsonLd } from '../utils/jsonld';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Logical path WITHOUT locale prefix (used for hreflang). */
  pathWithoutLocale?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  /**
   * Right-rail widgets. Omitted → no widget rail at all (the rail still
   * renders when an `aside-bottom` slot provides content, e.g. the TOC).
   * 'posts' → Recently Updated + Trending Tags (blog listing pages).
   * 'projects' → Recent Projects + Tech Stack (projects listing page).
   */
  panel?: 'posts' | 'projects';
  /** Constrain main content width (used by Pages like About/404). */
  narrow?: boolean;
  /** Breadcrumb segments shown in the topbar. */
  crumbs?: Array<{ label: string; href?: string }>;
  /** Pre-built SEO meta override. */
  seo?: SeoMeta;
  /** Page-specific JSON-LD block(s) merged with the sitewide nodes. */
  jsonld?: Array<Record<string, unknown>>;
  /**
   * Locales for which a translation of the current page actually
   * exists. Used to limit the language switcher to working links and
   * to scope hreflang alternates. Defaults to all `SITE.locales`.
   */
  availableLocales?: readonly Locale[];
}

const {
  title,
  description,
  ogImage,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags,
  panel,
  narrow = false,
  crumbs = [],
  seo,
  jsonld,
  availableLocales,
} = Astro.props;

const locale: Locale = detectLocale(Astro.url.pathname);
const t = useTranslations(locale);
const lang = htmlLang(locale);
const dir = htmlDir(locale);

const pathWithoutLocale = Astro.props.pathWithoutLocale ?? stripLocale(Astro.url.pathname);
const meta: SeoMeta =
  seo ??
  buildSeo({
    title,
    description,
    pathWithoutLocale,
    fullPath: Astro.url.pathname,
    locale,
    ogImage,
    type,
    publishedTime,
    modifiedTime,
    tags,
    availableLocales,
  });

// Structured data: sitewide WebSite + Person, plus the page's own block
// (BlogPosting / CreativeWork) and breadcrumbs when the page declares them.
// Crumbs without an href are the current page — only the last one gets the
// canonical URL; middle items without a link are dropped (never invent URLs).
const breadcrumbItems = crumbs
  .map((crumb, i) => ({
    name: crumb.label,
    url: crumb.href
      ? new URL(crumb.href, SITE.url).toString()
      : i === crumbs.length - 1
        ? meta.canonical
        : undefined,
  }))
  .filter((item): item is { name: string; url: string } => Boolean(item.url));
const breadcrumb = breadcrumbJsonLd(breadcrumbItems);
const jsonLdBlocks = [
  websiteJsonLd(locale),
  personJsonLd(),
  ...(jsonld ?? []),
  ...(breadcrumb ? [breadcrumb] : []),
];
---

<!doctype html>
<html lang={lang} dir={dir} data-theme="lofi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f5f5" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#141414" />
    {/* SVG favicon (all modern browsers) + .ico fallback (Safari). */}
    <link rel="icon" href={withBase(faviconImg.src)} type="image/svg+xml" />
    <link rel="icon" href={withBase(faviconIco)} />
    {/* Feed auto-discovery (<link rel="alternate">) is rendered by <SEO>. */}
    <SEO meta={meta} />
    {SITE.googleSiteVerification && (
      <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    )}
    <JsonLd data={jsonLdBlocks} />
    {/* Custom fonts configured via Astro Fonts API */}
    <Font cssVariable="--font-source-sans-3" />
    <Font cssVariable="--font-alexandria" />
    <Font cssVariable="--font-alexandria-latin" />
    <Font cssVariable="--font-lato" />
    <Font cssVariable="--font-source-serif-4" />
    <Font cssVariable="--font-noto-naskh-arabic" />
    <Font cssVariable="--font-noto-naskh-arabic-latin" />
    <Font cssVariable="--font-jetbrains-mono" preload />
    <ClientRouter />
    {/* Apply persisted theme as early as possible to avoid FOUC. */}
    <script is:inline>
      (function () {
        function applyTheme() {
          try {
            var stored = localStorage.getItem('theme');
            var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            var valid = stored === 'black' || stored === 'lofi';
            var theme = valid ? stored : prefersDark ? 'black' : 'lofi';
            if (!valid && stored) localStorage.setItem('theme', theme);
            document.documentElement.setAttribute('data-theme', theme);
          } catch {
            /* ignore */
          }
        }
        applyTheme();
        // Re-apply after view transitions swap in a fresh <html data-theme>.
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="focus:bg-primary focus:text-primary-content sr-only focus:not-sr-only focus:fixed focus:top-2 focus:start-2 focus:z-50 focus:rounded focus:px-3 focus:py-2"
    >
      {t('site.skipToContent')}
    </a>

    <Sidebar locale={locale} />

    <div class="chirpy-main-wrapper">
      <div class="chirpy-shell max-w-7xl">
        <Topbar locale={locale} crumbs={crumbs} availableLocales={availableLocales} />

        <div class="flex flex-1 gap-10">
          <div class="flex min-w-0 flex-1 flex-col">
            <main
              id="main"
              aria-label="Main Content"
              class:list={['min-w-0 flex-1 py-6 lg:pe-2', narrow ? 'mx-auto w-full max-w-3xl' : '']}
            >
              <slot />
            </main>

            <Footer locale={locale} />
          </div>

          {
            (panel || Astro.slots.has('aside-bottom')) && (
              <aside class="chirpy-panel-rail" aria-label="Sidebar widgets">
                {panel && <Panel locale={locale} variant={panel} />}
                <slot name="aside-bottom" />
              </aside>
            )
          }
        </div>
      </div>
    </div>

    <BackToTop />
  </body>
</html>
