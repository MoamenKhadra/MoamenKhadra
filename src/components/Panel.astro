---
/**
 * Right-hand panel shown on XL screens.
 *
 * variant="posts"     — Chirpy's "Recently Updated" + "Trending Tags"
 *                       (blog listing pages).
 * variant="projects"  — "Recent Projects" + "Tech Stack" chips
 *                       (projects listing page).
 *
 * On post pages this is not shown at all — the article TOC takes the rail
 * (handled by PostLayout via the `aside-bottom` slot).
 */
import type { Locale } from '../config';
import { useTranslations } from '../i18n/utils';
import { getPosts, getTagsWithCount, postPath, tagPath } from '../utils/posts';
import { getProjects, projectPath } from '../utils/projects';

interface Props {
  locale: Locale;
  variant: 'posts' | 'projects';
}

const { locale, variant } = Astro.props;
const t = useTranslations(locale);

const recentValue = (entry: { data: { updatedDate?: Date; pubDate?: Date } }) =>
  (entry.data.updatedDate ?? entry.data.pubDate)?.valueOf?.() ?? 0;

let recent: Array<{ href: string; title: string }>;
let chips: Array<{ label: string; href?: string }>;
let recentTitle: string;
let chipsTitle: string;

if (variant === 'posts') {
  const [posts, tags] = await Promise.all([getPosts(locale), getTagsWithCount(locale)]);

  recent = posts
    .slice()
    .sort((a, b) => recentValue(b) - recentValue(a))
    .slice(0, 5)
    .map((post) => ({ href: postPath(post), title: post.data.title }));

  chips = tags.slice(0, 8).map((tag) => ({ label: tag.name, href: tagPath(locale, tag.name) }));
  recentTitle = t('panel.recentlyUpdated');
  chipsTitle = t('panel.trendingTags');
} else {
  const projects = await getProjects(locale);

  recent = projects
    .slice()
    .sort((a, b) => recentValue(b) - recentValue(a))
    .slice(0, 5)
    .map((project) => ({ href: projectPath(project), title: project.data.title }));

  // Aggregate tech usage across projects, most frequent first.
  const techCount = new Map<string, number>();
  for (const project of projects) {
    for (const tech of project.data.tech) {
      techCount.set(tech, (techCount.get(tech) ?? 0) + 1);
    }
  }
  chips = [...techCount.entries()]
    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
    .slice(0, 8)
    .map(([label]) => ({ label }));
  recentTitle = t('panel.recentProjects');
  chipsTitle = t('panel.techTags');
}
---

<div class="chirpy-panel">
  {
    recent.length > 0 && (
      <section class="mb-8">
        <h2 class="text-base-content/70 mb-3 text-xs font-bold tracking-[0.1em] uppercase">
          {recentTitle}
        </h2>
        <ul class="chirpy-aside-list">
          {recent.map((item) => (
            <li>
              <a href={item.href} class="chirpy-aside-item truncate">
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    chips.length > 0 && (
      <section>
        <h2 class="text-base-content/70 mb-3 text-xs font-bold tracking-[0.1em] uppercase">
          {chipsTitle}
        </h2>
        <div class="flex flex-wrap gap-2">
          {chips.map((chip) =>
            chip.href ? (
              <a href={chip.href} class="post-tag">
                {chip.label}
              </a>
            ) : (
              <span class="badge badge-outline badge-sm">{chip.label}</span>
            ),
          )}
        </div>
      </section>
    )
  }
</div>
