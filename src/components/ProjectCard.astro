---
/**
 * Portfolio project card: thumbnail (fixed height, repo/demo pills on
 * the top corners) + title + description + tech badges (max 2 lines).
 * Used by the /projects listing. Projects without a hero image fall
 * back to the auto-generated OG image (mirrors PostLayout).
 */
import { SITE, type Locale } from '../config';
import { useTranslations, withBase } from '../i18n/utils';
import { projectPath, projectHeroImage, projectSlug, type Project } from '../utils/projects';
import SmartImage from './SmartImage.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  project: Project;
  locale: Locale;
  prioritizeLcp?: boolean;
}

const { project, locale, prioritizeLcp = false } = Astro.props;
const t = useTranslations(locale);
const href = projectPath(project);

const skipAutoOg = !SITE.autoOgImage || import.meta.env.CI_SKIP_AUTO_OG_IMAGE === 'true';
const ogPrefix = locale === SITE.defaultLocale ? '' : `${locale}/`;
const heroAsset =
  projectHeroImage(project) ??
  (skipAutoOg ? undefined : withBase(`/og/${ogPrefix}projects/${projectSlug(project)}.png`));
const heroAlt = project.data.heroImageAlt ?? project.data.title;
const { repo, demo } = project.data.links;
---

<article class="chirpy-card chirpy-card--vertical">
  <div class:list={['chirpy-card-link', heroAsset ? 'has-image' : 'no-image']}>
    {
      heroAsset && (
        <div class="chirpy-card-image-wrap">
          <SmartImage
            src={heroAsset}
            alt={heroAlt}
            class="chirpy-card-image"
            loading={prioritizeLcp ? 'eager' : 'lazy'}
            fetchpriority={prioritizeLcp ? 'high' : 'auto'}
            widths={[384, 768, 960]}
            sizes="(max-width: 767px) 100vw, 448px"
            quality={75}
          />

          {
            (repo || demo) && (
              <div class="chirpy-card-corner-links justify-start">
                {repo && (
                  <a
                    href={repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="chirpy-card-corner-link"
                    aria-label={t('projects.repo')}
                  >
                    <Icon name="lucide:github" width={12} height={12} />
                    {t('projects.repo')}
                  </a>
                )}
                {demo && (
                  <a
                    href={demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="chirpy-card-corner-link"
                    aria-label={t('projects.demo')}
                  >
                    <Icon name="lucide:external-link" width={12} height={12} />
                    {t('projects.demo')}
                  </a>
                )}
              </div>
            )
          }
        </div>
      )
    }

    <div class:list={['chirpy-card-body', heroAsset ? '' : 'full']}>
      <a href={href} class="chirpy-card-stretch">
        <h2 class="chirpy-card-title">
          {project.data.title}
        </h2>
      </a>

      <p
        class:list={[
          'text-base-content/70 text-base',
          heroAsset ? 'mt-2 mb-3 line-clamp-2' : 'mt-1 mb-2 line-clamp-3',
        ]}
      >
        {project.data.description}
      </p>

      {
        project.data.tech.length > 0 && (
          <div class="mt-auto line-clamp-2 pt-2">
            {project.data.tech.map((item) => (
              <span class="badge badge-outline badge-sm mr-1.5 mb-1.5">{item}</span>
            ))}
          </div>
        )
      }

      {
        !heroAsset && (repo || demo) && (
          <div class="chirpy-card-actions text-base-content/70 mt-3 flex items-center gap-3 text-xs">
            {repo && (
              <a
                href={repo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1"
              >
                <Icon name="lucide:github" width={12} height={12} />
                {t('projects.repo')}
              </a>
            )}
            {demo && (
              <a
                href={demo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1"
              >
                <Icon name="lucide:external-link" width={12} height={12} />
                {t('projects.demo')}
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</article>
