---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostList from '~/components/PostList.astro';
import Pagination from '~/components/Pagination.astro';
import { SITE } from '~/config';
import { localizedPath, useTranslations } from '~/i18n/utils';
import { getPosts } from '~/utils/posts';

export function getStaticPaths() {
  return SITE.locales.map((l) => ({
    params: { locale: l === SITE.defaultLocale ? undefined : l },
    props: { locale: l },
  }));
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const posts = await getPosts(locale);
const pageSize = SITE.postsPerPage;
const lastPage = Math.max(1, Math.ceil(posts.length / pageSize));
const currentPage = 1;
const pagePosts = posts.slice(0, pageSize);

const hrefForPage = (n: number) => localizedPath(n === 1 ? '/blog/' : `/blog/page/${n}/`, locale);
---

<BaseLayout
  title={t('nav.blog')}
  pathWithoutLocale="/blog/"
  crumbs={[{ label: t('nav.blog') }]}
  panel="posts"
>
  <header class="mb-6">
    <h1 class="text-3xl font-bold tracking-tight">{t('nav.blog')}</h1>
    {/* Secondary browse links: tags/categories/archives live outside the
        main nav, so keep them reachable from the blog landing page. */}
    <nav class="text-base-content/70 mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm" aria-label={t('nav.blog')}>
      <a href={localizedPath('/categories/', locale)} class="hover:text-primary">
        {t('nav.categories')}
      </a>
      <a href={localizedPath('/tags/', locale)} class="hover:text-primary">
        {t('nav.tags')}
      </a>
      <a href={localizedPath('/archives/', locale)} class="hover:text-primary">
        {t('nav.archives')}
      </a>
    </nav>
  </header>

  <PostList posts={pagePosts} locale={locale} />
  <Pagination
    currentPage={currentPage}
    lastPage={lastPage}
    hrefForPage={hrefForPage}
    locale={locale}
  />
</BaseLayout>
