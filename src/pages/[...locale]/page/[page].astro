---
/**
 * Legacy pagination redirect.
 *
 * The blog feed moved from `/page/N` to `/blog/page/N`. This route keeps
 * the old URLs alive by emitting a static meta-refresh page for every
 * historical pagination number (the standard redirect mechanism for
 * static hosts, which can't send real 301 responses).
 */
import type { GetStaticPaths } from 'astro';
import { SITE, type Locale } from '~/config';
import { localizedPath, htmlLang, htmlDir } from '~/i18n/utils';
import { getPosts } from '~/utils/posts';

interface Props {
  locale: Locale;
  current: number;
}

export const getStaticPaths: GetStaticPaths = async () => {
  let paths = [];
  for (const locale of SITE.locales) {
    const allPosts = await getPosts(locale);
    const totalPages = Math.ceil(allPosts.length / SITE.postsPerPage);
    const localeParams = { locale: locale === SITE.defaultLocale ? undefined : locale };
    for (let i = 2; i <= totalPages; i++) {
      paths.push({ params: { ...localeParams, page: String(i) }, props: { locale, current: i } });
    }
  }
  return paths;
};

const { locale, current } = Astro.props as Props;
const target = localizedPath(`/blog/page/${current}/`, locale);
---

<!doctype html>
<html lang={htmlLang(locale)} dir={htmlDir(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Redirecting…</title>
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
  </head>
  <body>
    <p><a href={target}>{target}</a></p>
  </body>
</html>
